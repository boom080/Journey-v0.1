# Shared local environment template. Copy to .env; never commit real secrets.
APP_ENV=local
APP_SECRET_KEY=replace-with-at-least-32-random-characters

POSTGRES_DB=journey
POSTGRES_USER=journey
POSTGRES_PASSWORD=replace-local-database-password
POSTGRES_PORT=55432
API_PORT=8000

DATABASE_URL=postgresql+psycopg://journey:replace-local-database-password@127.0.0.1:55432/journey
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:4173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Keep disabled for normal onboarding so every user creates their own local account.
# Automated tests may explicitly enable this isolated synthetic account.
SEED_TEST_ACCOUNT=false
TEST_ACCOUNT_EMAIL=demo@journey.local
TEST_ACCOUNT_USERNAME=journey_demo
TEST_ACCOUNT_PASSWORD=JourneyDemo2026

# Deterministic local Mock remains the committed default: no external request and zero cost.
# Switching AGENT_PROVIDER selects a server-side profile; never put these keys in Expo variables.
AGENT_PROVIDER=mock
# Text-model egress needs BOTH operator policy configuration and per-account consent.
# Do not enable until the provider retention/deletion policy has actually been reviewed.
AGENT_EXTERNAL_ENABLED=false
AGENT_PROVIDER_POLICY_URL=
AGENT_PROVIDER_RETENTION_NOTICE=
# Accountable deployment-owner review, at most 90 days, bound to the disclosure fingerprint.
# See infra/privacy/provider-review.example.json. Public policy links alone are insufficient.
AGENT_PROVIDER_REVIEW_JSON=
AGENT_DATA_RETENTION_DAYS=7
AGENT_V2_ENABLED=true
AGENT_V3_ENABLED=true
# Legacy active-provider key retained for backward compatibility. Prefer the provider-specific keys.
AGENT_API_KEY=
AGENT_API_BASE_URL=
AGENT_DEFAULT_MODEL=journey-deterministic-v1
AGENT_MODEL_MAP_JSON={}
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=1
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_DAILY_BUDGET_USD=0
AGENT_INPUT_USD_PER_MILLION=0
AGENT_OUTPUT_USD_PER_MILLION=0
LITELLM_LOG=ERROR
SEED_BUILTIN_KNOWLEDGE=true

# User-triggered public-link preview. It never uses cookies, credentials, images, or a model.
LIFE_INSPIRATION_FETCH_ENABLED=true

# Stage 9 food-image flow. Mock is local-only and never sends image bytes to a provider.
# DeepSeek V4 is text-only and is intentionally not a valid FOOD_IMAGE_PROVIDER.
FOOD_IMAGE_ANALYSIS_ENABLED=true
FOOD_IMAGE_PROVIDER=mock
FOOD_IMAGE_MODEL=journey-food-image-mock-v1
FOOD_IMAGE_API_BASE_URL=
FOOD_IMAGE_INPUT_USD_PER_MILLION=0
FOOD_IMAGE_OUTPUT_USD_PER_MILLION=0
FOOD_IMAGE_DAILY_BUDGET_USD=0
FOOD_IMAGE_EXTERNAL_UPLOAD_CONFIRMED=false
FOOD_IMAGE_MAX_BYTES=5242880
FOOD_IMAGE_MAX_DIMENSION=4096
EXPO_PUBLIC_FOOD_IMAGE_ANALYSIS_ENABLED=true
EXPO_PUBLIC_AGENT_DEBUG_DETAILS_ENABLED=true

# Historical isolated-evaluation example only. v0.2's application API rejects real image
# providers until a separate image-specific consent contract is implemented and accepted.
# FOOD_IMAGE_PROVIDER=qwen
# FOOD_IMAGE_MODEL=qwen3.7-flash
# QWEN_API_KEY=replace-in-local-dotenv-only
# FOOD_IMAGE_API_BASE_URL=replace-with-confirmed-regional-workspace-compatible-endpoint
# FOOD_IMAGE_INPUT_USD_PER_MILLION=replace-with-current-price
# FOOD_IMAGE_OUTPUT_USD_PER_MILLION=replace-with-current-price
# FOOD_IMAGE_DAILY_BUDGET_USD=0.10
# FOOD_IMAGE_EXTERNAL_UPLOAD_CONFIRMED=true

# Provider keys are stored independently so AGENT_PROVIDER can be switched without editing or
# forwarding another provider's credential. Empty keys keep profiles disabled.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# DeepSeek V4 opt-in example (keep Mock as the committed default). Flash handles routine parsing;
# Pro handles recommendation and weekly summary. Recheck prices before every real activation.
# AGENT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace-in-local-dotenv-only
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
# DEEPSEEK_MODEL_MAP_JSON={"recommendation":"deepseek-v4-pro","weekly_summary":"deepseek-v4-pro"}
# DEEPSEEK_MODEL_PRICING_JSON={"deepseek-v4-flash":{"input":0.14,"output":0.28},"deepseek-v4-pro":{"input":0.435,"output":0.87}}
# AGENT_DAILY_BUDGET_USD=0.10

# Future profiles are configuration-only until their own key, pricing, data policy, and contract
# tests are approved. Replace every 0.0 price below with the activation-day USD price; zero is
# intentionally rejected. Current official model defaults can always be overridden in local .env.
# AGENT_PROVIDER=qwen
# QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_DEFAULT_MODEL=qwen3.6-flash
# QWEN_MODEL_MAP_JSON={"recommendation":"qwen3.7-plus","weekly_summary":"qwen3.7-plus"}
# QWEN_MODEL_PRICING_JSON={"qwen3.6-flash":{"input":0.0,"output":0.0},"qwen3.7-plus":{"input":0.0,"output":0.0}}
# AGENT_PROVIDER=glm
# GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_DEFAULT_MODEL=glm-5.2
# GLM_MODEL_PRICING_JSON={"glm-5.2":{"input":0.0,"output":0.0}}
# AGENT_PROVIDER=kimi
# KIMI_API_BASE_URL=https://api.moonshot.cn/v1
# KIMI_DEFAULT_MODEL=kimi-k2.6
# KIMI_MODEL_PRICING_JSON={"kimi-k2.6":{"input":0.0,"output":0.0}}

# Leave unset for simulator defaults: iOS/Web use 127.0.0.1; Android uses 10.0.2.2.
# Set a LAN or HTTPS staging URL for a physical device.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000
