{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_FOOD_IMAGE_ANALYSIS_ENABLED": "true",
        "EXPO_PUBLIC_AGENT_DEBUG_DETAILS_ENABLED": "true"
      }
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_FOOD_IMAGE_ANALYSIS_ENABLED": "false",
        "EXPO_PUBLIC_AGENT_DEBUG_DETAILS_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_FOOD_IMAGE_ANALYSIS_ENABLED": "false",
        "EXPO_PUBLIC_AGENT_DEBUG_DETAILS_ENABLED": "false"
      }
    }
  }
}
