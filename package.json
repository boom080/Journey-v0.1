{
  "name": "journey",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "npm run start --workspace @journey/mobile",
    "mobile:ios": "npm run ios --workspace @journey/mobile",
    "mobile:android": "npm run android --workspace @journey/mobile",
    "mobile:web": "npm run web --workspace @journey/mobile",
    "mobile:web:build": "npm run web:build --workspace @journey/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @journey/mobile",
    "mobile:lint": "npm run lint --workspace @journey/mobile",
    "mobile:test": "npm run test --workspace @journey/mobile",
    "mobile:test:ci": "npm run test:ci --workspace @journey/mobile",
    "mobile:e2e:web": "npm run e2e:web --workspace @journey/mobile"
  }
}
