  "field_definitions": {
    "expected_intents": "输入应路由到的受支持意图，按输入中的任务顺序排列。",
    "record_status": "complete表示有足够内容可评估；insufficient表示缺少记录所需字段；unjudgeable表示不能从输入确定一条记录；mixed表示同时含多种记录类型。",
    "names": "输入明确列出的项目名称；item_count是同一记录类型的项目数。",
    "quantity.status": "explicit表示数量和单位都可由输入确定；ambiguous表示有模糊数量词；missing表示未提供数量。",
    "explicit_energy_kcal": "只填写输入明确给出的千卡数；没有该字段不代表可以推测热量。",
    "gold_status": "样本由Agent编写，等待人工复核；不表示已人工审核。"
  },
