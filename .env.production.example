# Copy to .env.production on the server. Never commit the populated file.
# SERVER_DOMAIN must have public A/AAAA DNS records pointing to the server.
SERVER_DOMAIN=journey.example.com
PUBLIC_ORIGIN=https://journey.example.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=journey
POSTGRES_USER=journey
# Use a long URL-safe value because the same password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-at-least-32-url-safe-random-characters
APP_SECRET_KEY=replace-with-at-least-64-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Production starts safely with deterministic Mock. Enabling a real provider requires its key,
# model pricing, and a positive budget; do not put any provider key in Expo variables.
AGENT_PROVIDER=mock
AGENT_DAILY_BUDGET_USD=0
AGENT_INPUT_USD_PER_MILLION=0
AGENT_OUTPUT_USD_PER_MILLION=0
LIFE_INSPIRATION_FETCH_ENABLED=false
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
