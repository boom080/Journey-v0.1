# Copy to .env.production on the server. Never commit the populated file.
# SERVER_DOMAIN must have public A/AAAA DNS records pointing to the server.
SERVER_DOMAIN=journey.example.com
PUBLIC_ORIGIN=https://journey.example.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=journey
POSTGRES_USER=journey
# Use a long URL-safe value because the same password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-at-least-32-url-safe-random-characters
APP_SECRET_KEY=replace-with-at-least-64-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Production fails closed when AGENT_PROVIDER is missing or mock. Set an approved external provider
# only after its data policy is accepted; keep every provider key on the server.
AGENT_PROVIDER=deepseek
AGENT_EXTERNAL_ENABLED=false
AGENT_PROVIDER_POLICY_URL=
AGENT_PROVIDER_RETENTION_NOTICE=
AGENT_PROVIDER_REVIEW_JSON=
AGENT_DATA_RETENTION_DAYS=7
DEEPSEEK_API_KEY=replace-with-production-server-key
AGENT_DAILY_BUDGET_USD=0.10
AGENT_INPUT_USD_PER_MILLION=0
AGENT_OUTPUT_USD_PER_MILLION=0
LIFE_INSPIRATION_FETCH_ENABLED=false
OPENAI_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
