WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

AI_ENABLED=true
AI_PROVIDER=qwen
AI_TIMEOUT_SECONDS=20
AI_TEXT_MODEL_CANDIDATES=qwen:qwen3-max,qwen:qwen-plus,qwen:qwen-turbo
AI_VISION_MODEL_CANDIDATES=qwen:qwen-vl-max,qwen:qwen-vl-plus

AI_FOOD_TEXT_ENABLED=true
AI_ACTIVITY_TEXT_ENABLED=true
AI_HOME_SUGGESTION_ENABLED=true
AI_FOOD_IMAGE_ENABLED=false
AI_ACTIVITY_OCR_ENABLED=false
AI_PDF_ENABLED=false
AI_RAG_ENABLED=false

AI_FOOD_TEXT_MODEL_CANDIDATES=
AI_ACTIVITY_TEXT_MODEL_CANDIDATES=
AI_HOME_SUGGESTION_MODEL_CANDIDATES=
AI_FOOD_IMAGE_MODEL_CANDIDATES=
AI_ACTIVITY_OCR_MODEL_CANDIDATES=
AI_PDF_MODEL_CANDIDATES=
AI_RAG_MODEL_CANDIDATES=

QWEN_API_KEY=在这里填写你的 API Key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max
